# PodSlacker local settings.
#
# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so your keys never reach GitHub.
#
# Used by:
#   - scripts/Set-PodSlackerEnv.ps1  (loads these into your PowerShell session)
#   - docker compose                 (reads .env automatically)
#
# Lines starting with # are comments. Leave a value empty to skip it.

# Required: LLM key for the summary, script and key-moment steps.
OPENROUTER_API_KEY=

# Optional: only when using OpenAI for TTS or as the LLM provider.
OPENAI_API_KEY=

# Optional: GitHub PAT (repo + pages scopes) for "Publish to GitHub Pages".
GITHUB_TOKEN=

# Optional: overrides the built-in key used by a YouTube transcript fallback.
YOUTUBE_API_KEY=

# Optional: require an X-Api-Key header on the API service.
PODSLACKER_API_KEY=
