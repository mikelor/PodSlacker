<Project>

  <!--
    Central Package Management — every NuGet version in the solution lives here.
    Project files reference packages with <PackageReference Include="..." /> only.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Keep packages that ship as a set on the same version. -->
    <AspireVersion>17.0.0</AspireVersion>
    <OpenCvSharpVersion>4.13.0.20261107</OpenCvSharpVersion>
  </PropertyGroup>

  <ItemGroup Label="AI">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions / ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.win-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.osx-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.osx-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.linux-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.win-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.osx-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.osx-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.linux-x64" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="OpenCV frame capture">
    <PackageVersion Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
    <PackageVersion Include="OpenCvSharp4.official.runtime.linux-x64" Version="$(OpenCvSharpVersion)" />
    <!-- NOTE: these two IDs were not found on nuget.org when the packages were
         last updated (Nov 2026), so the version is unchanged. macOS restore
         needs verifying. -->
    <PackageVersion Include="OpenCvSharp4.runtime.osx-arm64" Version="4.13.0.20260302" />
    <PackageVersion Include="OpenCvSharp4.runtime.osx-x64" Version="4.13.0.20260302" />
  </ItemGroup>

  <ItemGroup Label="Pipeline libraries">
    <PackageVersion Include="KokoroSharp.CPU" Version="0.8.5" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="YoutubeExplode" Version="6.6.3" />
  </ItemGroup>

</Project>
