<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PodSlacker.ServiceDefaults</RootNamespace>
    <!--
      IsAspireSharedProject is a workload-era property — omitting it avoids
      triggering NETSDK1228 on machines that still have the deprecated workload installed.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      FrameworkReference gives us WebApplication, HealthCheckOptions, etc.
      from the ASP.NET Core shared framework without switching the whole SDK.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NOTE: Microsoft.Extensions.Hosting is intentionally omitted here.
      IHostApplicationBuilder and all hosting abstractions are provided
      transitively by the FrameworkReference above — adding the NuGet package
      explicitly produces NU1510 ("will not be pruned / likely unnecessary").
    -->

    <!-- HTTP resilience and service discovery — keep versions in sync -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
