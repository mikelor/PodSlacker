<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>PodSlacker.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AI abstraction + OpenAI provider -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />

    <!-- DI, logging, config -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />

    <!-- Markdown → HTML -->
    <PackageReference Include="Markdig" />

    <!-- Frame capture (OpenCV) — platform-specific native binaries -->
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- ubuntu.22.04-x64 was never published beyond 4.6.0-SNAPSHOT; use the
         portable official linux-x64 runtime instead (Ubuntu 20.04+, Debian 10+, RHEL 8+) -->
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="OpenCvSharp4.runtime.osx-arm64"
                      Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'" />
    <PackageReference Include="OpenCvSharp4.runtime.osx-x64"
                      Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'" />

    <!-- YouTube (transcripts, metadata, stream URLs — replaces yt-dlp subprocess) -->
    <PackageReference Include="YoutubeExplode" />

    <!-- Kokoro local TTS (replaces Python Kokoro subprocess) -->
    <PackageReference Include="KokoroSharp.CPU" />

    <!-- GitHub API -->
    <PackageReference Include="Octokit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Prompts are embedded resources so that CLI, API, and Azure Functions
      all use the same canonical prompts from the Core DLL without any
      file-copying or deployment concerns.

      Priority at runtime:
        1. Explicit CLI override path via flag (e.g. -summary-prompt /path/to/file.txt)
        2. prompts/ folder next to the running executable  (for local customisation)
        3. These embedded resources  (canonical defaults, always available)
    -->
    <EmbeddedResource Include="prompts\summary.txt" LogicalName="PodSlacker.Core.prompts.summary.txt" />
    <EmbeddedResource Include="prompts\dialogue.txt" LogicalName="PodSlacker.Core.prompts.dialogue.txt" />
    <EmbeddedResource Include="prompts\monologue.txt" LogicalName="PodSlacker.Core.prompts.monologue.txt" />
    <EmbeddedResource Include="prompts\key_moments.txt" LogicalName="PodSlacker.Core.prompts.key_moments.txt" />
  </ItemGroup>

</Project>
